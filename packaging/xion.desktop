[Desktop Entry]
Type=Application
Version=1.0
Name=Xion
GenericName=File Manager
GenericName[fr]=Gestionnaire de fichiers
Comment=Browse and manage your files
Comment[fr]=Parcourir et gérer vos fichiers
# %U and not %f: a launcher passes a URI. `xion::cli::start_path` decodes it.
Exec=xion %U
Icon=xion
Terminal=false
StartupNotify=true
# Must match the `application_id` declared in `ui::app::run`, otherwise the
# window is not attached to this launcher: no grouped icon in the task bar, no
# visual feedback at startup.
StartupWMClass=xion
# A single main category (`System`): stacking two makes the entry appear twice
# in some menus. `FileTools` and `FileManager` are additional categories, which
# precisely need a main one.
Categories=System;FileTools;FileManager;
# What makes Xion eligible as the default file manager. The old
# `x-directory/normal` alias is deliberately absent: it is obsolete and
# `desktop-file-validate` flags it.
MimeType=inode/directory;
Keywords=files;folders;explorer;manager;browser;
Keywords[fr]=fichiers;dossiers;explorateur;gestionnaire;navigateur;
